{
  "$schema": "https://opencode.ai/config.json",

  // Local credentials (WiFi, API keys) belong in a git-ignored config.h in the
  // project root and must stay private: only a tracked template
  // (config.h.example) may be read or edited by an agent.
  // Rules are matched in order, the last match wins.
  "permissions": [
    // config.h holds local secrets and must never be read or edited.
    // read/edit cover read/write/patch; glob blocks pattern-based access.
    { "action": "read", "resource": "config.h", "effect": "deny" },
    { "action": "read", "resource": "*config.h", "effect": "deny" },
    { "action": "edit", "resource": "config.h", "effect": "deny" },
    { "action": "edit", "resource": "*config.h", "effect": "deny" },
    { "action": "glob", "resource": "config.h", "effect": "deny" },
    { "action": "glob", "resource": "*config.h", "effect": "deny" },

    // Shell commands are raw text. Block every form that names the real file
    // (as last argument, or followed by a separator or quotes); the tracked
    // template config.h.example stays usable in shell commands.
    { "action": "shell", "resource": "*config.h", "effect": "deny" },
    { "action": "shell", "resource": "*config.h *", "effect": "deny" },
    { "action": "shell", "resource": "*config.h;*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h|*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h&*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h>*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h<*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h\"*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h'*", "effect": "deny" },
    { "action": "shell", "resource": "*config.h)*", "effect": "deny" },

    // Example slide images are not part of the software and must never be
    // read, edited or discovered by any tool. Glob covers pattern-based reads.
    { "action": "read", "resource": "slides", "effect": "deny" },
    { "action": "read", "resource": "slides/*", "effect": "deny" },
    { "action": "read", "resource": "slides/**", "effect": "deny" },
    { "action": "read", "resource": "*slides", "effect": "deny" },
    { "action": "read", "resource": "*slides/*", "effect": "deny" },
    { "action": "read", "resource": "*slides/**", "effect": "deny" },
    { "action": "edit", "resource": "slides", "effect": "deny" },
    { "action": "edit", "resource": "slides/*", "effect": "deny" },
    { "action": "edit", "resource": "slides/**", "effect": "deny" },
    { "action": "edit", "resource": "*slides", "effect": "deny" },
    { "action": "edit", "resource": "*slides/*", "effect": "deny" },
    { "action": "edit", "resource": "*slides/**", "effect": "deny" },
    { "action": "glob", "resource": "slides", "effect": "deny" },
    { "action": "glob", "resource": "slides/*", "effect": "deny" },
    { "action": "glob", "resource": "slides/**", "effect": "deny" },
    { "action": "glob", "resource": "*slides", "effect": "deny" },
    { "action": "glob", "resource": "*slides/*", "effect": "deny" },
    { "action": "glob", "resource": "*slides/**", "effect": "deny" },

    // Shell commands are raw text. Match the slides directory specifically so
    // that unrelated names such as slideshow.c or build_slides.sh are not
    // blocked: the word must stand alone (at the start, or after a space or
    // slash), everything else may follow.
    { "action": "shell", "resource": "slides *", "effect": "deny" },
    { "action": "shell", "resource": "slides/*", "effect": "deny" },
    { "action": "shell", "resource": "* slides", "effect": "deny" },
    { "action": "shell", "resource": "* slides *", "effect": "deny" },
    { "action": "shell", "resource": "* slides/*", "effect": "deny" },
    { "action": "shell", "resource": "*slides", "effect": "deny" },
    { "action": "shell", "resource": "*/slides", "effect": "deny" },
    { "action": "shell", "resource": "*/slides/*", "effect": "deny" },
  ],
}
