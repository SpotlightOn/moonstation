{
  "$schema": "https://opencode.ai/config.json",

  // Local credentials (WiFi, API keys) belong in a git-ignored config.h in the
  // project root and must stay private: only a tracked template
  // (config.h.example) may be read or edited by an agent.
  //
  // These are `policies`, not `permissions`. `permissions` is a single ordered
  // array and a project-level one replaces the global one instead of extending
  // it, which silently drops every global rule (including its "ask before shell"
  // catch-all). Policies merge across configuration files, only ever tighten,
  // and cannot be lifted by an approval. The one permission policy for all
  // projects lives in ~/.config/opencode/opencode.jsonc.
  "policies": [
    // config.h holds local secrets and must never be read or edited.
    // The absolute-path form is covered by the leading wildcard.
    { "action": "tool.use", "resource": "read:config.h", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*config.h", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:config.h", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*config.h", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:config.h", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:*config.h", "effect": "deny" },

    // Shell commands are raw text. Block every form that names the real file
    // (as last argument, or followed by a separator or quotes); the tracked
    // template config.h.example stays usable in shell commands.
    { "action": "tool.use", "resource": "shell:*config.h", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h;*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h|*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h&*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h>*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h<*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h\"*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h'*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*config.h)*", "effect": "deny" },

    // Example slide images are not part of the software and must never be
    // read, edited or discovered by any tool. Glob covers pattern-based reads.
    { "action": "tool.use", "resource": "read:slides", "effect": "deny" },
    { "action": "tool.use", "resource": "read:slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:slides/**", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*slides", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*slides/**", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:slides", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:slides/**", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*slides", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*slides/**", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:slides", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:slides/**", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:*slides", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:*slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "glob:*slides/**", "effect": "deny" },

    // Shell commands are raw text. Match the slides directory specifically so
    // that unrelated names such as slideshow.c or build_slides.sh are not
    // blocked: the word must stand alone (at the start, or after a space or
    // slash), everything else may follow.
    { "action": "tool.use", "resource": "shell:slides *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:* slides", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:* slides *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:* slides/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*slides", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*/slides", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*/slides/*", "effect": "deny" },
  ],
}
