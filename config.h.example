// Local configuration of this build.
//
// Copy this file to config.h in the project root and adjust it. config.h is
// git-ignored and must never be committed. Every value below is optional:
// each one has a built-in default (the #ifndef fallbacks in
// src/config/settings.c), so a build without config.h still works.
//
// Where a value lives:
//   config.h    compile time: which features are built in, board level
//               wiring, and the defaults for the runtime settings
//   NVS / web   runtime values the owner tunes at home; they override the
//               defaults from here, see "Setup web server" below

#ifndef CONFIG_H
#define CONFIG_H

// ============================== Slideshow ==================================

// Time between two slides in milliseconds.
#define SLIDE_INTERVAL_MS 10000

// Directory on the SD card holding the 240x240 baseline JPEGs.
#define SLIDE_DIR "/slides"

// Crossfade between two images in milliseconds, 0 cuts hard. Needs a second
// frame buffer, which lives in PSRAM (the board has 8 MB); a build without
// PSRAM ignores the value. A transition costs about half a second of SPI
// traffic, so it is off by default for battery operation.
#define SLIDE_FADE_MS 0

// Low power while an image mode runs (1 = on, 0 = off). On, the CPU speed lock
// is only held while an image is read and decoded, so the power manager can
// drop the clock and let the chip sleep between two images. Off, the lock is
// held for the whole mode, which keeps the CPU at full speed and awake.
#define SLIDE_PM_LOW_POWER 1

// Automatic light sleep (1 = on, 0 = off). On, the chip sleeps whenever no lock
// is held, which needs less power but drops the native USB Serial/JTAG port:
// flashing and monitoring only work again with the board awake. The firmware
// blocks light sleep while a USB host is connected, but that path is untested;
// leave this off unless the board runs unplugged.
#define PM_LIGHT_SLEEP 0

// ================================ Display ==================================

// SPI clock of the GC9A01 panel in Hz. Board level, deliberately not part of
// the web form: a wrong value here blanks the display.
#define LCD_SPI_HZ 40000000

// Battery indicator below the weekday in the clock (1 = on, 0 = off).
#define CLOCK_SHOW_BATTERY 1

// Deep sleep for the clock inside a sleep window (1 = on, 0 = off). The
// display stays dark for the whole window and the board sleeps until the
// window ends; a touch lights it up for the normal dimming period. The RTC
// keeps the time while sleeping (drifts by seconds per day without a
// 32.768 kHz crystal); with WiFi configured the wake at the end of the
// window resyncs via NTP. Building it in also seeds the runtime setting of
// the same name, which the setup page flips at any time.
#define CLOCK_DEEP_SLEEP 0

// Sleep window in local hours [FROM, TO). A window that ends before it
// starts crosses midnight (23 -> 7); equal hours disable it.
#define CLOCK_DEEP_SLEEP_FROM 23
#define CLOCK_DEEP_SLEEP_TO 7

// Backlight auto-dimming: levels in percent, delays in seconds. The dim
// level is only reached while nothing is touched; the deep level follows.
#define BACKLIGHT_FULL_PCT 100
#define BACKLIGHT_DIM_PCT 20
#define BACKLIGHT_DEEP_PCT 5
#define BACKLIGHT_DIM_AFTER_SEC 15
#define BACKLIGHT_DEEP_AFTER_SEC 60

// =============================== Battery ===================================

// Charge level in percent at or below which the indicator turns red and the
// device beeps quietly on every refresh (0 = no warning).
#define BATTERY_WARN_PCT 10

// Volume of that warning beep in percent (0-100).
#define BATTERY_BEEP_VOLUME 30

// Seconds between battery samples; the ADC is never read more often.
#define BATTERY_REFRESH_SEC 300

// Number of ADC samples averaged per reading.
#define BATTERY_SAMPLE_COUNT 3

// Polarity of the charging input: 1 = the pin reads high while charging.
#define BATTERY_CHARGING_ACTIVE_HIGH 1

// ================================ Audio ====================================

// Volume of the touch and mode feedback tones in percent (0-100).
#define AUDIO_VOLUME 60

// ================================= WiFi ====================================

// Optional WiFi for the clock time sync and for the setup web server
// (uncomment and fill in). An empty SSID keeps the radio off, and the setup
// server then refuses to start: it needs an address to be reachable at.
// #define WIFI_SSID "your-ssid"
// #define WIFI_PASSWORD "your-password"

// Modem-sleep listen interval in beacon intervals; default 10 (about 1 s).
// Board level, no web form.
// #define WIFI_LISTEN_INTERVAL 10

// ================================= Time ====================================

// NTP server the clock syncs against. Queried on every boot, at the first
// wake-up outside the deep sleep window and at the daily resync below.
#define NTP_SERVER "time.nist.gov"

// Local hour of the daily resync while the board stays awake (-1 = off).
#define NTP_DAILY_SYNC_HOUR 4

// Standard (winter) UTC offset in hours, decimals allowed. Germany = 1
// (CET); summer time adds one hour on top when TIMEZONE_EU_DST is set.
#define TIMEZONE_STD_OFFSET_HOURS 1

// 1 = observe European summer time (last Sunday in March to the last Sunday
//     in October), 0 = keep the standard offset all year.
#define TIMEZONE_EU_DST 1

// ============================ Setup web server =============================

// Login of the configuration page, opened with the 5 s touch gesture. The
// page runs over HTTPS with a self-signed certificate, so the browser warns
// on the first visit - that is expected on a device without a domain.
//
// The password is empty by default, which switches authentication off and
// leaves the page open inside the local network. Set one before the box
// leaves the living room table. Both values can also be changed later from
// the page itself.
#define WEB_USER "admin"
#define WEB_PASSWORD ""

// Minutes without a request before the server shuts itself down again.
#define WEB_IDLE_TIMEOUT_MIN 15

// ================================ Weather ==================================

// OpenWeather key for the weather mode, free of charge at
// https://openweathermap.org/api. This value is only the default: the setup
// page writes the key into NVS, and that one wins. The page never shows the
// stored key again, so it is write-only there.
#define WEATHER_API_KEY ""

// Position the forecast is fetched for, in decimal degrees (WGS84). The
// weather mode asks OpenWeather directly by coordinate; the city name query
// is deprecated. Both values can also be changed on the setup page.
#define WEATHER_LAT 52.5200
#define WEATHER_LON 13.4050

// Minutes between two OpenWeather requests (5..1440). One refresh costs two
// requests, which leaves the free tier of 1000 calls per day untouched even
// at the shortest interval.
#define WEATHER_REFRESH_MIN 20

// ================================== Debug ==================================

// Write the frame after every mode switch as a 240x240 BMP to
// /sdcard/screens, so a layout problem can be checked without a photo of the
// panel. Turn it off again after debugging: the UI waits for the card while
// the file is written.
#define SCREENSHOT_ENABLE 0

// Additionally print each frame as hex on the console. Then a serial capture
// is enough to rebuild the image, no card reader needed. Costs about 250 kB of
// console output per frame and needs SCREENSHOT_ENABLE.
#define SCREENSHOT_SERIAL 0

#endif // CONFIG_H
